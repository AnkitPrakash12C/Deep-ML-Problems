import numpy as np

def train_simple_cnn_with_backprop(X, y, epochs, learning_rate, kernel_size=3, num_filters=1):
    """
    Trains a simple CNN with one convolutional layer, ReLU activation, flattening, 
    and a dense layer with softmax output using backpropagation.
    """
    n_samples, height, width = X.shape
    num_classes = y.shape[1]
    
    out_height = height - kernel_size + 1
    out_width = width - kernel_size + 1
    
    conv_weights = np.random.randn(kernel_size, kernel_size, num_filters) * 0.01
    conv_bias = np.zeros(num_filters)
    
    flatten_size = num_filters * out_height * out_width
    dense_weights = np.random.randn(flatten_size, num_classes) * 0.01
    dense_bias = np.zeros(num_classes)
    
    for epoch in range(epochs):
        for i in range(n_samples):
            x_img = X[i]
            y_true = y[i]
            

            conv_out = np.zeros((num_filters, out_height, out_width))
            for f in range(num_filters):
                for h in range(out_height):
                    for w in range(out_width):
                        region = x_img[h:h+kernel_size, w:w+kernel_size]

                        conv_out[f, h, w] = np.sum(region * conv_weights[:, :, f]) + conv_bias[f]
                        
            relu_out = np.maximum(0, conv_out)
            
            flatten_out = relu_out.flatten()
            
            logits = np.dot(flatten_out, dense_weights) + dense_bias
            
            exp_scores = np.exp(logits - np.max(logits))
            probs = exp_scores / np.sum(exp_scores)
            

            d_logits = probs - y_true
            

            d_dense_weights = np.outer(flatten_out, d_logits)
            d_dense_bias = d_logits
            

            d_flatten = np.dot(dense_weights, d_logits)
            

            d_relu = d_flatten.reshape(num_filters, out_height, out_width)

            d_conv_out = d_relu * (conv_out > 0)
            

            d_conv_weights = np.zeros_like(conv_weights)
            d_conv_bias = np.zeros_like(conv_bias)
            
            for f in range(num_filters):
                d_conv_bias[f] = np.sum(d_conv_out[f])
                for h in range(out_height):
                    for w in range(out_width):
                        region = x_img[h:h+kernel_size, w:w+kernel_size]

                        d_conv_weights[:, :, f] += d_conv_out[f, h, w] * region
                        

            conv_weights -= learning_rate * d_conv_weights
            conv_bias -= learning_rate * d_conv_bias
            dense_weights -= learning_rate * d_dense_weights
            dense_bias -= learning_rate * d_dense_bias
            
    return conv_weights, conv_bias, dense_weights, dense_bias
