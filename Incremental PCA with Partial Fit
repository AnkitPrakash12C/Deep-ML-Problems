import numpy as np

def incremental_pca(batches, n_components):
    """
    Computes Incremental PCA batch by batch.
    
    batches: list of batches of samples (list of list of list of floats)
    n_components: int, number of principal components to return
    Returns: list of lists, shape (n_components, n_features)
    """
    n_samples_seen = 0
    mean = None
    scatter = None

    for batch in batches:
        X = np.array(batch, dtype=float)
        if X.shape[0] == 0:
            continue

        batch_n_samples = X.shape[0]
        batch_mean = np.mean(X, axis=0)
        batch_scatter = (X - batch_mean).T @ (X - batch_mean)

        if n_samples_seen == 0:
            mean = batch_mean
            scatter = batch_scatter
            n_samples_seen = batch_n_samples
        else:
            N_new = n_samples_seen + batch_n_samples
            delta = batch_mean - mean

            mean = mean + delta * batch_n_samples / N_new


            scatter += batch_scatter + (n_samples_seen * batch_n_samples / N_new) * np.outer(delta, delta)

            n_samples_seen = N_new

    if n_samples_seen == 0:
        return []

    cov = scatter / n_samples_seen

    eigenvalues, eigenvectors = np.linalg.eigh(cov)

    idx = np.argsort(eigenvalues)[::-1]
    eigenvectors = eigenvectors[:, idx]


    components = eigenvectors[:, :n_components].T


    for i in range(len(components)):

        max_abs_idx = np.argmax(np.abs(components[i]))

        if components[i, max_abs_idx] < 0:
            components[i] = -components[i]

    return components.tolist()
