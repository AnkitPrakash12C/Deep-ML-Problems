import numpy as np

def video_tokenizer_reconstruct(video, patch_t: int, patch_h: int, patch_w: int, mode: str):
    video_arr = np.array(video, dtype=float)
    T, H, W, C = video_arr.shape
    
    pt = 1 if mode == 'spatial' else patch_t
    
    reconstructed = np.empty_like(video_arr)
    
    for t in range(0, T, pt):
        for h in range(0, H, patch_h):
            for w in range(0, W, patch_w):
                patch_mean = np.mean(video_arr[t:t+pt, h:h+patch_h, w:w+patch_w, :], axis=(0, 1, 2))
                reconstructed[t:t+pt, h:h+patch_h, w:w+patch_w, :] = patch_mean
                
    return reconstructed.tolist()
